FROM alpine:3.24@sha256:28bd5fe8b56d1bd048e5babf5b10710ebe0bae67db86916198a6eec434943f8b

LABEL maintainer="taoziyoyo <dev@taoziyoyo.com>"

WORKDIR /

RUN apk add --no-cache ca-certificates tzdata \
    && mkdir -p /var/log/xray

ARG XRAY_VERSION
ARG XRAY_SHA256_AMD64
ARG XRAY_SHA256_ARM64
ARG TARGETARCH

LABEL org.opencontainers.image.version="${XRAY_VERSION}" \
      io.taoziyoyo.xray.version="${XRAY_VERSION}"

RUN set -eux \
    && case "${TARGETARCH}" in \
        amd64) XRAY_ASSET="Xray-linux-64.zip"; XRAY_SHA256="${XRAY_SHA256_AMD64}" ;; \
        arm64) XRAY_ASSET="Xray-linux-arm64-v8a.zip"; XRAY_SHA256="${XRAY_SHA256_ARM64}" ;; \
        *) echo "Unsupported architecture: ${TARGETARCH}"; exit 1 ;; \
    esac \
    && [ -n "${XRAY_VERSION}" ] \
    && [ "${#XRAY_SHA256}" -eq 64 ] \
    && wget -O "/tmp/${XRAY_ASSET}" "https://github.com/XTLS/Xray-core/releases/download/${XRAY_VERSION}/${XRAY_ASSET}" \
    && printf '%s  %s\n' "${XRAY_SHA256}" "/tmp/${XRAY_ASSET}" | sha256sum -c - \
    && unzip "/tmp/${XRAY_ASSET}" -d /usr/bin/ \
    && rm -f "/tmp/${XRAY_ASSET}" \
    && chmod +x /usr/bin/xray \
    && xray -version | head -n 1 | grep -qF "${XRAY_VERSION#v}"

COPY ./entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh \
    && adduser -D -u 10000 xray \
    && chown xray /usr/bin/xray \
    && chown -R xray /var/log/xray

ENV TZ=Asia/Shanghai

USER 10000

ENTRYPOINT ["/entrypoint.sh"]
EXPOSE 8443
