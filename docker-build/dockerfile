# Dockerfile - Binary Download Version (Stable & Fast)
FROM alpine:latest
LABEL maintainer="taoziyoyo <user@taoziyoyo.com>"

WORKDIR /

# 1. 安装基础依赖
# ca-certificates: 用于 HTTPS 请求
# tzdata: 用于设置时区
RUN apk add --no-cache ca-certificates tzdata \
    && mkdir -p /var/log/xray

# 2. 下载并解压 Xray 核心 (直接从 GitHub Release 获取)
# 使用多架构逻辑 (AMD64/ARM64 自动适配)
ARG TARGETARCH
RUN set -ex \
    && case "${TARGETARCH}" in \
        amd64) XRAY_ARCH="64" ;; \
        arm64) XRAY_ARCH="arm64-v8a" ;; \
        *) echo "Unsupported architecture: ${TARGETARCH}"; exit 1 ;; \
    esac \
    && wget -O /tmp/xray.zip "https://github.com/XTLS/Xray-core/releases/latest/download/Xray-linux-${XRAY_ARCH}.zip" \
    && unzip /tmp/xray.zip -d /usr/bin/ \
    && rm -f /tmp/xray.zip \
    && chmod +x /usr/bin/xray

# 3. 复制你的启动脚本
COPY ./entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

# 4. 设置环境
ENV TZ=Asia/Shanghai

# -D: 不设置密码, -u: 指定UID
RUN adduser -D -u 10000 xray

# 【新增】处理权限问题
# 1. 把 Xray 二进制文件的所有权给 xray 用户 (虽然读权限通常够，但为了保险)
# 2. 预先创建日志目录，并把所有权给 xray 用户，否则它没权限写
RUN chown xray /usr/bin/xray \
    && mkdir -p /var/log/xray \
    && chown -R xray /var/log/xray

# 【新增】构建时的冒烟测试 (Smoke Test)
# 这一步至关重要！它会在构建过程中尝试运行 xray。
# 如果报错 "not found" 或 "exec format error"，构建会直接失败，不会推送到 Docker Hub。
RUN xray -version

# 【新增】切换到非 Root 用户
USER 10000

# 5. 设置入口点和暴露端口
ENTRYPOINT ["/entrypoint.sh"]
# 【修改】非 Root 用户不能监听 443，我们改用 8443
EXPOSE 8443