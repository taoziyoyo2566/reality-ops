{% set socks5_module = socks5_egress | default({}) %}
{% set socks5_module_enabled = socks5_module.enabled | default(false) %}
{% set socks5_profiles = socks5_module.profiles | default({}) %}
{
  "log": {
    "loglevel": {{ reality_log_level | default('warning') | to_json }},
    "access": "/var/log/xray/access.log",
    "error": "/var/log/xray/error.log"
  },
  "api": {
    "tag": "api",
    "services": ["HandlerService", "LoggerService", "StatsService"]
  },
  "stats": {},
  "policy": {
    "levels": {
      "0": {
        "handshake": 4,
        "connIdle": 300,
        "uplinkOnly": 0,
        "downlinkOnly": 0,
        "bufferSize": 0,
        "statsUserUplink": true,    {# 开启统计核心：用户上行 #}
        "statsUserDownlink": true   {# 开启统计核心：用户下行 #}
      }
    },
    "system": {
      "statsInboundUplink": true,
      "statsInboundDownlink": true,
      "statsOutboundUplink": true,
      "statsOutboundDownlink": true,
      "checkAccount": true,
      "strict": true
    }
  },
  "routing": {
    "domainStrategy": "IPIfNonMatch",
    "rules": [
      {
        "type": "field",
        "inboundTag": ["api"],
        "outboundTag": "api"
      },
      {# 可以在这里加屏蔽规则，比如屏蔽 bt 下载等 #}
      {
        "type": "field",
        "protocol": ["bittorrent"],
        "outboundTag": "blocked"
      }
      {% if socks5_module_enabled %}
      {% for _p in socks5_profiles | dict2items | sort(attribute='value.priority') %}
      {% set profile_name = _p.key %}
      {% set profile = _p.value %}
      {% set route = profile.route | default({}) %}
      {% set route_hosts = route.hosts | default([]) %}
      {% set route_users = route.users | default([]) %}
      {% set route_domains = route.domains | default([]) %}
      {% set route_ips = route.ips | default([]) %}
      {% set route_protocols = route.protocols | default([]) %}
      {% set route_network = route.network | default('') %}
      {% set host_matches = (route_hosts | length == 0) or (inventory_hostname in route_hosts) %}
      {% set profile_complete = (profile.enabled | default(false) | bool) and (profile.address | default('') | length > 0) and ((profile.port | default(0) | int) > 0) %}
      {% set inbound_tags = [] %}
      {% for user_item in reality_instances if user_item.name in route_users %}
      {% set _ = inbound_tags.append('user-' ~ user_item.name) %}
      {% endfor %}
      {% set has_route_rule = (inbound_tags | length > 0) or (route_domains | length > 0) or (route_ips | length > 0) or (route_protocols | length > 0) %}
      {% if profile_complete and host_matches and has_route_rule %}
      ,
      {
        "type": "field"
        {% if inbound_tags | length > 0 %},
        "inboundTag": {{ inbound_tags | to_json }}
        {% endif %}
        {% if route_domains | length > 0 %},
        "domain": {{ route_domains | to_json }}
        {% endif %}
        {% if route_ips | length > 0 %},
        "ip": {{ route_ips | to_json }}
        {% endif %}
        {% if route_protocols | length > 0 %},
        "protocol": {{ route_protocols | to_json }}
        {% endif %}
        {% if route_network | length > 0 %},
        "network": {{ route_network | to_json }}
        {% endif %},
        "outboundTag": {{ ('socks5-profile-' ~ profile_name) | to_json }}
      }
      {% endif %}
      {% endfor %}
      {% endif %}
      {# 注意：不需要写 catch-all 的 direct 规则，默认会走第一个 outbound #}
    ]
  },
  "inbounds": [
    {# 1. 管理端口：API 服务（始终保留，避免无用户时配置无效） #}
    {
      "port": 10085,
      "listen": "127.0.0.1",
      "protocol": "dokodemo-door",
      "settings": {
        "address": "127.0.0.1"
      },
      "tag": "api"
    }
    {# 2. 业务端口：按授权用户追加 #}
    {% for item in reality_instances %}
    ,
    {
      "port": {{ item.port }},
      "tag": {{ ('user-' ~ item.name) | to_json }},
      "protocol": "vless",
      "settings": {
        "clients": [
          {
            "id": "{{ item.uuid }}",
            "email": "{{ item.name }}.{{ inventory_hostname }}",
            "flow": "xtls-rprx-vision",
            "level": 0,
            "alterId": 0
          }
        ],
        "decryption": "none"
      },
      "streamSettings": {
        "network": "tcp",
        "security": "reality",
        "realitySettings": {
          "show": false,
          "dest": "{{ reality_dest }}",
          "xver": 0,
          "serverNames": {{ reality_server_names | to_json }},
          "privateKey": "{{ item.private_key }}",
          "shortIds": ["{{ item.short_id }}"]
        }
      }
    }
    {% endfor %}
  ],
  "outbounds": [
    {
      "protocol": "freedom",
      "settings": {},
      "tag": "direct"
    },
    {
      "protocol": "blackhole",
      "settings": {},
      "tag": "blocked"
    }
    {% if socks5_module_enabled %}
    {% for _p in socks5_profiles | dict2items | sort(attribute='value.priority') %}
    {% set profile_name = _p.key %}
    {% set profile = _p.value %}
    {% set profile_complete = (profile.enabled | default(false) | bool) and (profile.address | default('') | length > 0) and ((profile.port | default(0) | int) > 0) %}
    {% if profile_complete %}
    ,
    {
      "protocol": "socks",
      "settings": {
        "address": {{ profile.address | to_json }},
        "port": {{ profile.port | int }}
        {% if (profile.username | default('') | length > 0) or (profile.password | default('') | length > 0) %}
        ,
        "user": {{ profile.username | default('') | to_json }},
        "pass": {{ profile.password | default('') | to_json }}
        {% endif %}
      },
      "tag": {{ ('socks5-profile-' ~ profile_name) | to_json }}
    }
    {% endif %}
    {% endfor %}
    {% endif %}
  ]
}
