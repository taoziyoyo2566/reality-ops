{
  "log": {
    "loglevel": "warning",
    "access": "/var/log/xray/access.log",
    "error": "/var/log/xray/error.log"
  },
  "api": {
    "tag": "api",
    "services": ["HandlerService", "LoggerService", "StatsService"]
  },
  "stats": {},
  "policy": {
    "levels": {
      "0": {
        "handshake": 4,
        "connIdle": 300,
        "uplinkOnly": 0,
        "downlinkOnly": 0,
        "bufferSize": 0,
        "connLimit": {{ reality_conn_limit_single | default(24) }},
        "statsUserUplink": true,    {# 开启统计核心：用户上行 #}
        "statsUserDownlink": true   {# 开启统计核心：用户下行 #}
      }
    },
    "system": {
      "statsInboundUplink": true,
      "statsInboundDownlink": true,
      "statsOutboundUplink": true,
      "statsOutboundDownlink": true,
      "checkAccount": true,
      "strict": true
    }
  },
  "routing": {
    "domainStrategy": "IPIfNonMatch",
    "rules": [
      {
        "type": "field",
        "inboundTag": ["api"],
        "outboundTag": "api"
      },
      {# 可以在这里加屏蔽规则，比如屏蔽 bt 下载等 #}
      {
        "type": "field",
        "protocol": ["bittorrent"],
        "outboundTag": "blocked"
      }
      {# 注意：不需要写 catch-all 的 direct 规则，默认会走第一个 outbound #}
    ]
  },
  "inbounds": [
    {# 1. 管理端口：API 服务（始终保留，避免无用户时配置无效） #}
    {
      "port": 10085,
      "listen": "127.0.0.1",
      "protocol": "dokodemo-door",
      "settings": {
        "address": "127.0.0.1"
      },
      "tag": "api"
    }
    {# 2. 业务端口：按授权用户追加 #}
    {% for item in reality_instances %}
    ,
    {
      "port": {{ item.port }},
      "protocol": "vless",
      "settings": {
        "clients": [
          {
            "id": "{{ item.uuid }}",
            "email": "{{ item.name }}.{{ inventory_hostname }}",
            "flow": "xtls-rprx-vision",
            "level": 0,
            "alterId": 0
          }
        ],
        "decryption": "none"
      },
      "streamSettings": {
        "network": "tcp",
        "security": "reality",
        "realitySettings": {
          "show": false,
          "dest": "{{ reality_dest }}",
          "xver": 0,
          "serverNames": {{ reality_server_names | to_json }},
          "privateKey": "{{ item.private_key }}",
          "shortIds": ["{{ item.short_id }}"]
        }
      }
    }
    {% endfor %}
  ],
  "outbounds": [
    {
      "protocol": "freedom",
      "settings": {},
      "tag": "direct"
    },
    {
      "protocol": "blackhole",
      "settings": {},
      "tag": "blocked"
    }
  ]
}
