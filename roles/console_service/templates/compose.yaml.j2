# {{ ansible_managed | default('managed by reality-ops') }}
# 管理控制台 compose 项目。合同：docs/reviews/console/plan-console-phase1-2026-09-16.md §3.1、§3.6
{% set logging = {"driver": "json-file", "options": {"max-size": console_docker_log_max_size | string, "max-file": console_docker_log_max_file | string}} %}
{% set hardening = {"read_only": true, "tmpfs": ["/tmp"], "cap_drop": ["ALL"], "security_opt": ["no-new-privileges:true"], "pids_limit": 64, "mem_limit": console_memory_limit, "logging": logging} %}
name: {{ console_compose_project | to_json }}

services:
  # 管理页面：只发布到宿主机 127.0.0.1，经 SSH 隧道访问；写订阅服务的数据目录，只读其访问日志。
  web:
    image: {{ console_image | to_json }}
    container_name: {{ (console_container_name ~ '_web') | to_json }}
    restart: unless-stopped
    user: {{ (console_uid ~ ':' ~ console_uid) | to_json }}
    command: ["python", "-m", "console.web_app"]
    environment:
      CONSOLE_PORT: {{ console_web_port | string | to_json }}
      CONSOLE_PUBLIC_BASE_URL: {{ subs_public_base_url | to_json }}
      CONSOLE_ALLOWED_HOSTS: {{ console_allowed_hosts | join(',') | to_json }}
      CONSOLE_OFFLINE_MINUTES: {{ console_offline_minutes | string | to_json }}
      CONSOLE_BACKUP_KEEP: {{ console_backup_keep | string | to_json }}
    ports: [{{ ('127.0.0.1:' ~ console_web_port ~ ':' ~ console_web_port) | to_json }}]
    volumes:
      - {{ (console_root_dir ~ '/data:/data:ro') | to_json }}
      - {{ (console_registry_dir ~ ':/registry:ro') | to_json }}
      - {{ (console_root_dir ~ '/db:/db') | to_json }}
      - {{ (console_root_dir ~ '/import:/import:ro') | to_json }}
      - {{ (subs_root_dir ~ '/data:/subs-data') | to_json }}
      - {{ (subs_root_dir ~ '/db:/subs-db:ro') | to_json }}
    networks: [admin]
{% for key, value in hardening.items() %}
    {{ key }}: {{ value | to_json }}
{% endfor %}

  # 节点上报：只在内部网络，由 cloudflared 转发；不含管理页面路由。
  report:
    image: {{ console_image | to_json }}
    container_name: {{ (console_container_name ~ '_report') | to_json }}
    restart: unless-stopped
    user: {{ (console_uid ~ ':' ~ console_uid) | to_json }}
    command: ["python", "-m", "console.report_app"]
    environment:
      CONSOLE_PORT: {{ console_report_port | string | to_json }}
    volumes:
      - {{ (console_registry_dir ~ ':/registry:ro') | to_json }}
      - {{ (console_root_dir ~ '/db:/db') | to_json }}
    networks: [internal]
{% for key, value in hardening.items() %}
    {{ key }}: {{ value | to_json }}
{% endfor %}

  # 控制台自己的隧道；公共主机名 {{ console_report_host }} 在 Cloudflare 上指向 http://report:{{ console_report_port }}。
  cloudflared:
    image: {{ console_cloudflared_image | to_json }}
    container_name: {{ (console_container_name ~ '_cloudflared') | to_json }}
    restart: unless-stopped
    command: ["tunnel", "run"]
    env_file: [{{ (console_root_dir ~ '/secrets/tunnel.env') | to_json }}]
    depends_on: [report]
    networks: [internal, egress]
{% for key, value in hardening.items() %}
    {{ key }}: {{ value | to_json }}
{% endfor %}

networks:
  admin: {}
  internal:
    internal: true
  egress: {}
