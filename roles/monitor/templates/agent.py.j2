import subprocess
import json
import requests
import os
import re
from collections import defaultdict

NODE_NAME = "{{ inventory_hostname }}"
# 【核心】此处引用 monitor.server_public_ip 和 monitor.port
SERVER_URL = "{{ monitor.server_url }}/report"
# 【核心】此处引用 monitor.report_token (来自 vault)
API_TOKEN = "{{ monitor.report_token }}"
CACHE_FILE = "/tmp/reality_traffic_cache.json"
LOG_FILE = "/opt/reality/logs/reality_core/access.log"  # 用于用户-IP 采集
REALITY_MODE = "{{ reality_mode | default('single') }}"


def load_cache():
    """向后兼容地读取缓存，返回 (users, container)。"""
    try:
        with open(CACHE_FILE, 'r') as f:
            data = json.load(f)
            if isinstance(data, dict) and "users" in data:
                return data.get("users", {}), data.get("container")
            if isinstance(data, dict):
                # 旧格式：仅用户流量
                return data, None
    except Exception:
        pass
    return {}, None


def save_cache(users, container=None):
    payload = {"users": users}
    if container:
        payload["container"] = container
    try:
        with open(CACHE_FILE, 'w') as f:
            json.dump(payload, f)
    except Exception:
        pass


def list_multi_containers():
    """列出多实例容器（reality_<user>，排除 reality_core）。"""
    cmd = "docker ps --format '{% raw %}{{.Names}}{% endraw %}'"
    res = subprocess.run(cmd, shell=True, capture_output=True, text=True)
    if res.returncode != 0:
        return []
    names = [n.strip() for n in res.stdout.splitlines() if n.strip()]
    return [n for n in names if n.startswith("reality_") and n != "reality_core"]


def get_container_bytes(container):
    """读取容器内 eth0 的累计收发字节数。"""
    def read_stat(stat):
        cmd = f"docker exec {container} cat /sys/class/net/eth0/statistics/{stat}_bytes"
        res = subprocess.run(cmd, shell=True, capture_output=True, text=True)
        if res.returncode != 0:
            return None
        try:
            return int(res.stdout.strip())
        except Exception:
            return None

    rx = read_stat("rx")
    tx = read_stat("tx")
    if rx is None or tx is None:
        return None
    return {"down": rx, "up": tx}


def get_multi_stats():
    """多实例：按容器网络字节数统计每用户流量。"""
    stats = {}
    for name in list_multi_containers():
        counters = get_container_bytes(name)
        if not counters:
            continue
        user = name.replace("reality_", "", 1)
        stats[user] = counters
    return stats

def get_core_stats():
    # 只查询 reality_core 容器
    cmd = "docker exec reality_core xray api statsquery --server=127.0.0.1:10085"
    try:
        res = subprocess.run(cmd, shell=True, capture_output=True, text=True)
        if res.returncode != 0: return {}
        data = json.loads(res.stdout)
        
        stats = {}
        if 'stat' in data:
            for item in data['stat']:
                parts = item['name'].split('>>>')
                if len(parts) == 4 and parts[0] == 'user':
                    raw_user = parts[1]
                    # 清洗用户名，去掉主机名后缀
                    real_user = raw_user.split('.')[0] if '.' in raw_user else raw_user
                    
                    type_ = parts[3]
                    val = int(item['value'])
                    
                    if real_user not in stats: stats[real_user] = {'up': 0, 'down': 0}
                    if type_ == 'uplink': stats[real_user]['up'] += val
                    if type_ == 'downlink': stats[real_user]['down'] += val
        return stats
    except:
        return {}

def main():
    if REALITY_MODE == "single":
        current = get_core_stats()
        container_now = get_container_bytes("reality_core")
    else:
        current = get_multi_stats()
        container_now = None

    # 兜底：single 模式未返回数据且存在多实例容器时，尝试多实例统计
    if not current and REALITY_MODE == "single":
        fallback = get_multi_stats()
        if fallback:
            current = fallback
            container_now = container_now or get_container_bytes("reality_core")

    last, last_container = load_cache()

    deltas = {}
    total_up = total_down = 0
    for user, flow in current.items():
        last_flow = last.get(user, {'up': 0, 'down': 0})
        
        up_delta = flow['up'] - last_flow['up']
        if up_delta < 0: up_delta = flow['up']
        
        down_delta = flow['down'] - last_flow['down']
        if down_delta < 0: down_delta = flow['down']
        
        deltas[user] = {"up": up_delta, "down": down_delta}
        total_up += up_delta
        total_down += down_delta

    # 若统计流量明显小于容器网络流量，则用容器流量放大对齐（single 模式）
    up_factor = down_factor = 1.0
    if REALITY_MODE == "single" and container_now and last_container:
        container_up = max(0, container_now.get("up", 0) - last_container.get("up", 0))
        container_down = max(0, container_now.get("down", 0) - last_container.get("down", 0))
        if container_up > 0 and total_up > 0:
            up_factor = max(1.0, container_up / total_up)
        if container_down > 0 and total_down > 0:
            down_factor = max(1.0, container_down / total_down)
    
    for user, delta in deltas.items():
        adj_up = int(delta["up"] * up_factor)
        adj_down = int(delta["down"] * down_factor)
        
        if adj_up > 0 or adj_down > 0:
            try:
                # 【核心】Header 中携带 Token
                requests.post(SERVER_URL, json={
                    "node": NODE_NAME, "user": user, 
                    "up_delta": adj_up, "down_delta": adj_down
                }, headers={"token": API_TOKEN}, timeout=5)
            except: pass

    save_cache(current, container_now)

def collect_user_ips():
    """
    简单解析 access.log，按用户提取唯一 IP 列表。
    仅读取最近部分内容，避免日志过大；重复上报会在服务端去重。
    """
    if not os.path.isfile(LOG_FILE):
        return {}
    try:
        ips = defaultdict(set)
        # 只看最近几千行，避免读取超大文件
        with open(LOG_FILE, 'r', encoding='utf-8', errors='ignore') as f:
            lines = f.readlines()[-4000:]
        for line in lines:
            # 形如: ... from <ip>:port ... email: <user>
            ip_match = re.search(r"from ([^\\s:]+)", line)
            user_match = re.search(r"email:\\s*([^\\s]+)", line)
            if not ip_match or not user_match:
                continue
            ip = ip_match.group(1).strip()
            user = user_match.group(1).strip()
            if ip and user:
                ips[user].add(ip)
        # 转换为普通 dict -> list
        return {user: list(values) for user, values in ips.items()}
    except Exception:
        return {}

def send_ip_report(user_ips):
    if not user_ips:
        return
    try:
        payload = {
            "node": NODE_NAME,
            "entries": [{"user": u, "ips": ips} for u, ips in user_ips.items()],
        }
        requests.post(
            SERVER_URL.replace("/report", "/stats/ip_report"),
            json=payload,
            headers={"token": API_TOKEN},
            timeout=5,
        )
    except Exception:
        pass

if __name__ == "__main__":
    main()
    # 额外上报用户-IP 去重信息（用于共享判定）
    send_ip_report(collect_user_ips())
