  <script data-cfasync="false">
    window.__monitorEarlyErrors = [];
    window.addEventListener("error", function (event) {
      if (!window.__monitorEarlyErrors) return;
      var location = event.filename ? event.filename + ":" + event.lineno + ":" + event.colno : "";
      window.__monitorEarlyErrors.push({
        level: "error",
        message: event.message || "Script error",
        detail: location
      });
    });
    window.addEventListener("unhandledrejection", function (event) {
      if (!window.__monitorEarlyErrors) return;
      var reason = event.reason && event.reason.stack ? event.reason.stack : String(event.reason || "");
      window.__monitorEarlyErrors.push({
        level: "error",
        message: "Unhandled promise rejection",
        detail: reason
      });
    });
  </script>
  <script data-cfasync="false">
    (() => {
      const state = { hours: 24, detail: true, query: "" };
      const fmt = new Intl.NumberFormat("en-US", { maximumFractionDigits: 2 });
      const fmtInt = new Intl.NumberFormat("en-US");
      const palette = [
        "linear-gradient(90deg, #ff7a59, #f2b94c)",
        "linear-gradient(90deg, #21a8a4, #8bd9c2)",
        "linear-gradient(90deg, #2aa0ff, #21d4fd)",
