@app.get("/stats/daily", dependencies=[Depends(auth_guard)])
async def get_daily_stats(hours: int = 24, detail: bool = True):
    """
    获取流量报表
    - detail=True (默认): 按 [用户 + 节点] 分组，显示每个用户在每个节点的用量
    - detail=False: 仅按 [用户] 分组，显示总账
    """
    return fetch_daily_stats(hours, detail)

@app.get("/stats/timeseries", dependencies=[Depends(auth_guard)])
async def get_timeseries(hours: int = 24, interval: int = 3600, user: str = None, node: str = None):
    hours = max(1, hours)
    interval = max(300, min(interval, 86400))
    now = int(time.time())
    start_time = now - (hours * 3600)
    conn = sqlite3.connect(DB_PATH)
    c = conn.cursor()

    query = '''SELECT (timestamp - (timestamp % ?)) as bucket, SUM(up), SUM(down)
               FROM records WHERE timestamp > ?'''
    params = [interval, start_time]
    if user:
        query += " AND user = ?"
        params.append(user)
    if node:
        query += " AND node = ?"
        params.append(node)
    query += " GROUP BY bucket ORDER BY bucket"

    c.execute(query, params)
    rows = c.fetchall()
    conn.close()

    series = [
        {
            "bucket": r[0],
            "upload_mb": round((r[1] or 0) / 1024 / 1024, 2),
            "download_mb": round((r[2] or 0) / 1024 / 1024, 2),
            "total_mb": round(((r[1] or 0) + (r[2] or 0)) / 1024 / 1024, 2)
        }
        for r in rows
    ]
    return {"start": start_time, "end": now, "interval": interval, "series": series}

@app.get("/stats/health", dependencies=[Depends(auth_guard)])
async def get_health(hours: int = 24, stale_minutes: int = 10):
    hours = max(1, hours)
    now = int(time.time())
    stale_seconds = max(60, stale_minutes * 60)
    conn = sqlite3.connect(DB_PATH)
    c = conn.cursor()

    c.execute("SELECT node, MAX(timestamp) FROM records GROUP BY node")
    last_seen_rows = c.fetchall()
    last_seen = {r[0]: r[1] for r in last_seen_rows}

    c.execute('''SELECT node, SUM(up), SUM(down), COUNT(*) FROM records WHERE timestamp > ?
                 GROUP BY node''', (now - (hours * 3600),))
    window_rows = c.fetchall()
    window_map = {r[0]: {"up": r[1] or 0, "down": r[2] or 0, "count": r[3] or 0} for r in window_rows}
    conn.close()

    result = []
    for node_name, seen_at in last_seen.items():
        window = window_map.get(node_name, {"up": 0, "down": 0, "count": 0})
        age = now - seen_at if seen_at else None
        total_mb = round((window["up"] + window["down"]) / 1024 / 1024, 2)
        result.append({
            "node": node_name,
            "last_seen": seen_at,
            "last_seen_ago_sec": age,
            "upload_mb": round(window["up"] / 1024 / 1024, 2),
            "download_mb": round(window["down"] / 1024 / 1024, 2),
            "total_mb": total_mb,
            "report_count": window["count"],
            "stale": age is None or age > stale_seconds
        })

    result.sort(key=lambda item: (item["stale"], item["last_seen"] or 0), reverse=True)
    return result

@app.get("/stats/export", dependencies=[Depends(auth_guard)])
async def export_stats(hours: int = 24, detail: bool = True, format: str = "csv"):
    data = fetch_daily_stats(hours, detail)
    if format.lower() == "json":
        return data

    buffer = io.StringIO()
    writer = csv.writer(buffer)
    writer.writerow(["user", "node", "upload_mb", "download_mb", "total_mb"])
    for row in data:
        writer.writerow([
            row.get("user", ""),
            row.get("node", ""),
            row.get("upload_mb", 0),
            row.get("download_mb", 0),
            row.get("total_mb", 0)
        ])

    filename = f"traffic_{hours}h_{'detail' if detail else 'summary'}.csv"
    headers = {"Content-Disposition": f'attachment; filename="{filename}"'}
    return Response(content=buffer.getvalue(), media_type="text/csv", headers=headers)

@app.post("/stats/cleanup", dependencies=[Depends(auth_guard)])
async def cleanup_stats(days: int = 90, token: str = Header(None)):
    if token != REPORT_TOKEN:
        raise HTTPException(status_code=403, detail="Invalid Token")
    days = max(1, days)
    cutoff = int(time.time()) - (days * 86400)
    conn = sqlite3.connect(DB_PATH)
    c = conn.cursor()
    c.execute("DELETE FROM records WHERE timestamp < ?", (cutoff,))
    deleted = c.rowcount
    conn.commit()
    conn.close()
    return {"deleted": deleted, "cutoff": cutoff}

@app.get("/subs/logs", dependencies=[Depends(auth_guard)])
async def get_subscription_logs(limit: int = 200, sub_id: Optional[str] = None):
    if not SUBS_PROXY_ENABLED:
        return []
    limit = max(1, min(limit, 1000))
    conn = sqlite3.connect(DB_PATH)
    c = conn.cursor()
    if sub_id:
        c.execute(
            "SELECT sub_id, ip, forwarded_for, user_agent, query, timestamp FROM subscription_logs WHERE sub_id = ? ORDER BY timestamp DESC LIMIT ?",
            (sub_id, limit),
        )
    else:
        c.execute(
            "SELECT sub_id, ip, forwarded_for, user_agent, query, timestamp FROM subscription_logs ORDER BY timestamp DESC LIMIT ?",
            (limit,),
        )
    rows = c.fetchall()
    conn.close()
    return [
        {
            "sub_id": r[0],
            "ip": r[1],
            "forwarded_for": r[2],
            "user_agent": r[3],
            "query": r[4],
            "timestamp": r[5],
        }
        for r in rows
    ]

def proxy_subscription_internal(sub_id: str, request: Request, token: Optional[str] = None):
    if not SUBS_PROXY_ENABLED or not SUBS_GIST_USER or not SUBS_GIST_ID:
        raise HTTPException(status_code=404, detail="Not configured")
    if SUBS_REQUIRE_TOKEN and SUBS_TOKEN and token != SUBS_TOKEN:
        raise HTTPException(status_code=403, detail="Invalid Token")
    log_subscription_hit(sub_id, request)
    target_url = f"https://gist.githubusercontent.com/{SUBS_GIST_USER}/{SUBS_GIST_ID}/raw/{sub_id}"
    return RedirectResponse(url=target_url, status_code=307)

@app.get("/{sub_id}")
async def proxy_subscription_alias(sub_id: str, request: Request, token: Optional[str] = None):
    reserved = {"stats", "docs", "openapi.json", "subs", "debug", "report"}
    if sub_id in reserved:
        raise HTTPException(status_code=404, detail="Not configured")
    return proxy_subscription_internal(sub_id, request, token)

