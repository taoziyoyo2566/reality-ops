      const detailToggle = document.getElementById("detail-toggle");
      const searchInput = document.getElementById("search-input");
      const refreshBtn = document.getElementById("refresh-btn");
      const lastRefresh = document.getElementById("last-refresh");
      const recordCount = document.getElementById("record-count");
      const totalTraffic = document.getElementById("total-traffic");
      const totalUp = document.getElementById("total-up");
      const totalDown = document.getElementById("total-down");
      const userCount = document.getElementById("user-count");
      const nodeCount = document.getElementById("node-count");
      const nodeSub = document.getElementById("node-sub");
      const topUser = document.getElementById("top-user");
      const topUserTraffic = document.getElementById("top-user-traffic");
      const userChart = document.getElementById("user-chart");
      const nodeChart = document.getElementById("node-chart");
      const nodeCard = document.getElementById("node-card");
      const tableBody = document.getElementById("table-body");
      const emptyState = document.getElementById("empty-state");
      const statusEl = document.getElementById("status");
      const tableHint = document.getElementById("table-hint");
      const windowLabel = document.getElementById("window-label");
      const alertInput = document.getElementById("alert-input");
      const exportBtn = document.getElementById("export-btn");
      const alertList = document.getElementById("alert-list");
      const alertEmpty = document.getElementById("alert-empty");
      const alertHint = document.getElementById("alert-hint");
      const trendChart = document.getElementById("trend-chart");
      const trendStart = document.getElementById("trend-start");
      const trendEnd = document.getElementById("trend-end");
      const healthBody = document.getElementById("health-body");
      const healthEmpty = document.getElementById("health-empty");
      const logList = document.getElementById("log-list");
      const logEmpty = document.getElementById("log-empty");
      const logClear = document.getElementById("log-clear");
      const logCopy = document.getElementById("log-copy");

      let cachedRows = [];
      let logs = [];
      const LOG_KEY = "realityMonitorLogs";
      const LOG_LIMIT = 200;

      function readQuery() {
        const params = new URLSearchParams(window.location.search);
        const hoursParam = parseInt(params.get("hours"), 10);
        if (!Number.isNaN(hoursParam)) {
          state.hours = hoursParam;
        }
        const detailParam = params.get("detail");
        if (detailParam !== null) {
          state.detail = detailParam === "true";
        }
      }

      function syncControls() {
        hoursSelect.value = String(state.hours);
        detailToggle.checked = state.detail;
        windowLabel.textContent = state.hours + "h";
      }

      function updateQuery() {
        const url = new URL(window.location.href);
        url.searchParams.set("hours", String(state.hours));
        url.searchParams.set("detail", state.detail ? "true" : "false");
        window.history.replaceState(null, "", url);
      }

      function setStatus(message) {
        statusEl.textContent = message;
      }

      function loadLogs() {
        try {
          const raw = localStorage.getItem(LOG_KEY);
          const parsed = raw ? JSON.parse(raw) : [];
          logs = Array.isArray(parsed) ? parsed : [];
        } catch (error) {
          logs = [];
        }
      }

      function saveLogs() {
        try {
          localStorage.setItem(LOG_KEY, JSON.stringify(logs));
        } catch (error) {
          // ignore localStorage failures
        }
      }

      function addLog(level, message, detail) {
        const entry = {
          ts: Date.now(),
          level: level || "info",
          message: String(message || ""),
          detail: detail ? String(detail) : ""
        };
        logs.unshift(entry);
        if (logs.length > LOG_LIMIT) {
          logs = logs.slice(0, LOG_LIMIT);
        }
        saveLogs();
        renderLogs();
      }

      function renderLogs() {
        if (!logList || !logEmpty) return;
        logList.innerHTML = "";
        if (!logs.length) {
          logEmpty.style.display = "block";
          return;
        }
        logEmpty.style.display = "none";
        const fragment = document.createDocumentFragment();
        logs.forEach((entry) => {
          const row = document.createElement("div");
          row.className = "log-item";

          const time = document.createElement("div");
          time.className = "log-time";
          time.textContent = new Date(entry.ts).toLocaleString();

          const level = document.createElement("div");
          level.className = "log-level " + entry.level;
          level.textContent = entry.level;

          const message = document.createElement("div");
          message.className = "log-message";
          message.textContent = entry.message + (entry.detail ? "\n" + entry.detail : "");

          row.appendChild(time);
          row.appendChild(level);
          row.appendChild(message);
          fragment.appendChild(row);
        });
        logList.appendChild(fragment);
      }

      function formatAge(seconds) {
        if (!Number.isFinite(seconds) || seconds < 0) return "--";
        if (seconds < 60) return Math.floor(seconds) + "s";
        const minutes = Math.floor(seconds / 60);
        if (minutes < 60) return minutes + "m";
        const hours = Math.floor(minutes / 60);
        if (hours < 24) return hours + "h";
        const days = Math.floor(hours / 24);
        return days + "d";
      }

      function pickInterval(hours) {
        if (hours <= 24) return 3600;
        if (hours <= 72) return 7200;
        if (hours <= 168) return 21600;
        return 86400;
      }

      function formatTick(ts) {
        const date = new Date(ts * 1000);
        if (state.hours > 36) {
          return date.toLocaleDateString();
        }
        return date.toLocaleTimeString([], { hour: "2-digit", minute: "2-digit" });
      }

      function aggregateBy(data, key) {
        const map = new Map();
        data.forEach((row) => {
          const label = String(row[key] || "-");
          const value = Number(row.total_mb || 0);
          map.set(label, (map.get(label) || 0) + value);
        });
        return Array.from(map.entries()).map(([label, value]) => ({ label, value }));
      }

      function renderBars(container, items) {
        container.innerHTML = "";
        if (!items.length) {
          const empty = document.createElement("div");
          empty.className = "chart-empty";
          empty.textContent = "No data";
          container.appendChild(empty);
          return;
        }
        const maxValue = Math.max(...items.map((item) => item.value), 1);
        items.forEach((item, index) => {
          const row = document.createElement("div");
          row.className = "bar-row";
          const label = document.createElement("div");
          label.className = "bar-label";
          const labelText = document.createElement("span");
          labelText.textContent = item.label;
          const valueText = document.createElement("span");
          valueText.textContent = fmt.format(item.value) + " MB";
          label.appendChild(labelText);
          label.appendChild(valueText);
          const track = document.createElement("div");
          track.className = "bar-track";
          const fill = document.createElement("div");
          fill.className = "bar-fill";
          const width = Math.max(6, (item.value / maxValue) * 100);
          fill.style.width = width + "%";
          fill.style.background = palette[index % palette.length];
          track.appendChild(fill);
          row.appendChild(label);
          row.appendChild(track);
          container.appendChild(row);
        });
      }

      function renderTrend(payload) {
        if (!trendChart) return;
        const series = payload && Array.isArray(payload.series) ? payload.series : [];
        const interval = payload && payload.interval ? payload.interval : 3600;
        const start = payload && payload.start ? payload.start : null;
        const end = payload && payload.end ? payload.end : null;
        if (!series.length || !start || !end) {
          trendChart.innerHTML = "<text x=\"16\" y=\"24\" fill=\"#5e6676\">No data</text>";
          if (trendStart) trendStart.textContent = "--";
          if (trendEnd) trendEnd.textContent = "--";
          return;
        }

        const startBucket = Math.floor(start / interval) * interval;
        const endBucket = Math.floor(end / interval) * interval;
        const map = new Map(series.map((item) => [item.bucket, item]));
        const filled = [];
        for (let t = startBucket; t <= endBucket; t += interval) {
          const item = map.get(t) || { bucket: t, total_mb: 0 };
          filled.push(item);
        }

        const maxValue = Math.max(...filled.map((item) => Number(item.total_mb || 0)), 1);
        const width = 800;
        const height = 180;
        const padding = 18;
        const span = Math.max(filled.length - 1, 1);
        const points = filled.map((item, index) => {
          const x = padding + ((width - padding * 2) * index) / span;
          const y =
            height - padding - ((height - padding * 2) * Number(item.total_mb || 0)) / maxValue;
          return { x, y };
        });
        const line = points
          .map((point, index) => (index === 0 ? "M" : "L") + point.x + "," + point.y)
          .join(" ");
        const area =
          line +
          " L" +
          (padding + (width - padding * 2)) +
          "," +
          (height - padding) +
          " L" +
          padding +
          "," +
          (height - padding) +
          " Z";

        trendChart.setAttribute("viewBox", "0 0 " + width + " " + height);
        trendChart.innerHTML =
          "<defs>" +
          "<linearGradient id=\"trendFill\" x1=\"0\" x2=\"0\" y1=\"0\" y2=\"1\">" +
          "<stop offset=\"0%\" stop-color=\"#ff7a59\" stop-opacity=\"0.35\" />" +
          "<stop offset=\"100%\" stop-color=\"#ff7a59\" stop-opacity=\"0\" />" +
          "</linearGradient>" +
          "</defs>" +
          "<path d=\"" +
          area +
          "\" fill=\"url(#trendFill)\" />" +
          "<path d=\"" +
          line +
          "\" fill=\"none\" stroke=\"#ff7a59\" stroke-width=\"3\" stroke-linecap=\"round\" />" +
          "<circle cx=\"" +
          points[points.length - 1].x +
          "\" cy=\"" +
          points[points.length - 1].y +
          "\" r=\"4\" fill=\"#ff7a59\" />";

        if (trendStart) trendStart.textContent = formatTick(startBucket);
        if (trendEnd) trendEnd.textContent = formatTick(endBucket);
      }

      function renderAlerts(rows) {
        if (!alertList || !alertEmpty || !alertInput) return;
        const threshold = parseFloat(alertInput.value);
        const limit = 8;
        const minValue = Number.isFinite(threshold) ? threshold : 0;
        if (alertHint) alertHint.textContent = "Over " + fmt.format(minValue) + " MB";

        const alerts = [];
        const userAgg = aggregateBy(rows, "user");
        userAgg.forEach((item) => {
          if (item.value >= minValue) {
            alerts.push({ type: "User", label: item.label, value: item.value });
          }
        });
        if (state.detail) {
          const nodeAgg = aggregateBy(
            rows.filter((row) => row.node && row.node !== "ALL"),
            "node"
          );
          nodeAgg.forEach((item) => {
            if (item.value >= minValue) {
              alerts.push({ type: "Node", label: item.label, value: item.value });
            }
          });
        }
        alerts.sort((a, b) => b.value - a.value);
        alertList.innerHTML = "";
        if (!alerts.length) {
          alertEmpty.style.display = "block";
          return;
        }
        alertEmpty.style.display = "none";
        const fragment = document.createDocumentFragment();
        alerts.slice(0, limit).forEach((item) => {
          const row = document.createElement("div");
          row.className = "alert-item";
          const label = document.createElement("div");
          label.textContent = item.type + ": " + item.label;
          const value = document.createElement("div");
          value.className = "alert-meta";
          value.textContent = fmt.format(item.value) + " MB";
          row.appendChild(label);
          row.appendChild(value);
          fragment.appendChild(row);
        });
        alertList.appendChild(fragment);
      }

      function renderHealth(rows) {
        if (!healthBody || !healthEmpty) return;
        healthBody.innerHTML = "";
        if (!rows.length) {
          healthEmpty.style.display = "block";
          return;
        }
        healthEmpty.style.display = "none";
        const fragment = document.createDocumentFragment();
        rows.forEach((row) => {
          const tr = document.createElement("tr");
          const tdNode = document.createElement("td");
          tdNode.textContent = row.node || "-";
          const tdLast = document.createElement("td");
          tdLast.textContent = row.last_seen ? new Date(row.last_seen * 1000).toLocaleString() : "--";
          const tdAge = document.createElement("td");
          tdAge.textContent = formatAge(row.last_seen_ago_sec);
          const tdTotal = document.createElement("td");
          tdTotal.className = "num";
          tdTotal.textContent = fmt.format(row.total_mb || 0);
          const tdStatus = document.createElement("td");
          const badge = document.createElement("span");
          badge.className = "badge " + (row.stale ? "stale" : "ok");
          badge.textContent = row.stale ? "Stale" : "Ok";
          tdStatus.appendChild(badge);
          tr.appendChild(tdNode);
          tr.appendChild(tdLast);
          tr.appendChild(tdAge);
          tr.appendChild(tdTotal);
          tr.appendChild(tdStatus);
          fragment.appendChild(tr);
        });
        healthBody.appendChild(fragment);
      }

      function renderTable(rows) {
        tableBody.innerHTML = "";
        const query = state.query.toLowerCase();
        const filtered = rows.filter((row) => {
          const user = String(row.user || "").toLowerCase();
          const node = String(row.node || "").toLowerCase();
          if (!query) return true;
          return user.includes(query) || node.includes(query);
        });
        filtered.sort((a, b) => Number(b.total_mb || 0) - Number(a.total_mb || 0));
        tableHint.textContent = "Showing " + filtered.length + " of " + rows.length;

        if (!filtered.length) {
          emptyState.style.display = "block";
          return;
        }
        emptyState.style.display = "none";
        const fragment = document.createDocumentFragment();
        filtered.forEach((row) => {
          const tr = document.createElement("tr");
          const tdUser = document.createElement("td");
          tdUser.textContent = row.user || "-";
          const tdNode = document.createElement("td");
          tdNode.textContent = row.node === "ALL" ? "All" : row.node || "-";
          const tdUp = document.createElement("td");
          tdUp.className = "num";
          tdUp.textContent = fmt.format(row.upload_mb || 0);
          const tdDown = document.createElement("td");
          tdDown.className = "num";
          tdDown.textContent = fmt.format(row.download_mb || 0);
          const tdTotal = document.createElement("td");
          tdTotal.className = "num";
          tdTotal.textContent = fmt.format(row.total_mb || 0);
          tr.appendChild(tdUser);
          tr.appendChild(tdNode);
          tr.appendChild(tdUp);
          tr.appendChild(tdDown);
          tr.appendChild(tdTotal);
          fragment.appendChild(tr);
        });
        tableBody.appendChild(fragment);
      }

      function render(data) {
        const totalUpValue = data.reduce((sum, row) => sum + Number(row.upload_mb || 0), 0);
        const totalDownValue = data.reduce((sum, row) => sum + Number(row.download_mb || 0), 0);
        const totalValue = data.reduce((sum, row) => sum + Number(row.total_mb || 0), 0);
        const users = new Set(data.map((row) => row.user).filter(Boolean));
        const nodes = new Set(
          data.map((row) => row.node).filter((node) => node && node !== "ALL")
        );

        totalTraffic.textContent = fmt.format(totalValue) + " MB";
        totalUp.textContent = fmt.format(totalUpValue);
        totalDown.textContent = fmt.format(totalDownValue);
        userCount.textContent = fmtInt.format(users.size);
        if (state.detail) {
          nodeCount.textContent = fmtInt.format(nodes.size);
          nodeSub.textContent = "Active nodes in window";
          nodeCard.style.display = "block";
        } else {
          nodeCount.textContent = "--";
          nodeSub.textContent = "Detail mode off";
          nodeCard.style.display = "none";
        }

        const userAgg = aggregateBy(data, "user").sort((a, b) => b.value - a.value);
        const nodeAgg = state.detail
          ? aggregateBy(data.filter((row) => row.node && row.node !== "ALL"), "node").sort((a, b) => b.value - a.value)
          : [];

        const topUserItem = userAgg[0];
        topUser.textContent = topUserItem ? topUserItem.label : "--";
        topUserTraffic.textContent = topUserItem ? fmt.format(topUserItem.value) + " MB" : "0 MB";

        renderBars(userChart, userAgg.slice(0, 8));
        if (state.detail) {
          renderBars(nodeChart, nodeAgg.slice(0, 8));
        }
        renderTable(data);
        renderAlerts(data);
      }

      async function loadTrend() {
        const interval = pickInterval(state.hours);
        try {
          const response = await fetch(
            `/stats/timeseries?hours=${state.hours}&interval=${interval}`,
            { cache: "no-store" }
          );
          if (!response.ok) {
            throw new Error("HTTP " + response.status);
          }
          const payload = await response.json();
          renderTrend(payload);
        } catch (error) {
          renderTrend(null);
          addLog("error", "Failed to load /stats/timeseries", error.message || String(error));
        }
      }

      async function loadHealth() {
        try {
          const response = await fetch(`/stats/health?hours=${state.hours}`, { cache: "no-store" });
          if (!response.ok) {
            throw new Error("HTTP " + response.status);
          }
          const data = await response.json();
          renderHealth(Array.isArray(data) ? data : []);
        } catch (error) {
          renderHealth([]);
          addLog("error", "Failed to load /stats/health", error.message || String(error));
        }
      }

      async function loadData() {
        setStatus("Fetching data...");
        updateQuery();
        syncControls();
        try {
          const response = await fetch(`/stats/daily?hours=${state.hours}&detail=${state.detail}`, { cache: "no-store" });
          if (!response.ok) {
            throw new Error("HTTP " + response.status);
          }
          const data = await response.json();
          const rows = Array.isArray(data) ? data : [];
          cachedRows = rows;
          recordCount.textContent = fmtInt.format(rows.length);
          lastRefresh.textContent = new Date().toLocaleTimeString();
          setStatus("Live data for the last " + state.hours + " hours");
          render(rows);
        } catch (error) {
          recordCount.textContent = "0";
          setStatus("Failed to load data");
          cachedRows = [];
          render([]);
          addLog("error", "Failed to load /stats/daily", error.message || String(error));
        }
        await Promise.all([loadTrend(), loadHealth()]);
      }

      hoursSelect.addEventListener("change", () => {
        state.hours = parseInt(hoursSelect.value, 10);
        loadData();
      });
      detailToggle.addEventListener("change", () => {
        state.detail = detailToggle.checked;
        loadData();
      });
      searchInput.addEventListener("input", () => {
        state.query = searchInput.value.trim();
        renderTable(cachedRows);
      });
      alertInput.addEventListener("input", () => {
        renderAlerts(cachedRows);
      });
      refreshBtn.addEventListener("click", loadData);
      exportBtn.addEventListener("click", () => {
        const url = `/stats/export?hours=${state.hours}&detail=${state.detail}&format=csv`;
        window.open(url, "_blank");
      });
      logClear.addEventListener("click", () => {
        logs = [];
        saveLogs();
        renderLogs();
      });
      logCopy.addEventListener("click", () => {
        const text = logs
          .map((entry) => {
            const time = new Date(entry.ts).toLocaleString();
            const detail = entry.detail ? " | " + entry.detail.replace(/\n/g, " ") : "";
            return "[" + time + "] " + entry.level.toUpperCase() + " " + entry.message + detail;
          })
          .join("\n");
        const blob = new Blob([text || "No logs"], { type: "text/plain" });
        const url = URL.createObjectURL(blob);
        const link = document.createElement("a");
        link.href = url;
        link.download = "monitor_logs.txt";
        link.click();
        URL.revokeObjectURL(url);
      });

      window.addEventListener("error", (event) => {
        const location = event.filename ? event.filename + ":" + event.lineno + ":" + event.colno : "";
        addLog("error", event.message || "Script error", location);
      });
      window.addEventListener("unhandledrejection", (event) => {
        const reason = event.reason && event.reason.stack ? event.reason.stack : String(event.reason || "");
        addLog("error", "Unhandled promise rejection", reason);
      });

      const earlyErrors = window.__monitorEarlyErrors || [];
      if (Array.isArray(earlyErrors)) {
        earlyErrors.forEach((entry) => {
          addLog(entry.level || "error", entry.message || "Script error", entry.detail || "");
        });
        window.__monitorEarlyErrors = null;
      }

      loadLogs();
      renderLogs();
      readQuery();
      syncControls();
      loadData();
    })();
  </script>
</body>
</html>
"""

os.makedirs(os.path.dirname(DB_PATH), exist_ok=True)

def init_db():
    conn = sqlite3.connect(DB_PATH)
    c = conn.cursor()
    c.execute('''CREATE TABLE IF NOT EXISTS records
                 (id INTEGER PRIMARY KEY AUTOINCREMENT,
                  node TEXT, user TEXT, up INTEGER, down INTEGER, timestamp INTEGER)''')
    c.execute("CREATE INDEX IF NOT EXISTS idx_records_timestamp ON records (timestamp)")
    c.execute("CREATE INDEX IF NOT EXISTS idx_records_user ON records (user)")
    c.execute("CREATE INDEX IF NOT EXISTS idx_records_node ON records (node)")
    c.execute('''CREATE TABLE IF NOT EXISTS subscription_logs
                 (id INTEGER PRIMARY KEY AUTOINCREMENT,
                  sub_id TEXT,
                  ip TEXT,
                  forwarded_for TEXT,
                  user_agent TEXT,
                  query TEXT,
                  timestamp INTEGER)''')
    c.execute("CREATE INDEX IF NOT EXISTS idx_subscription_logs_sub_id ON subscription_logs (sub_id)")
    c.execute("CREATE INDEX IF NOT EXISTS idx_subscription_logs_ts ON subscription_logs (timestamp)")
    conn.commit()
    conn.close()

init_db()

class TrafficReport(BaseModel):
    node: str
    user: str
    up_delta: int
    down_delta: int

def get_client_ip(request: Request) -> str:
    if TRUST_PROXY_HEADER:
        header_val = request.headers.get(TRUST_PROXY_HEADER)
        if header_val:
            return header_val.split(",")[0].strip()
    return request.client.host if request.client else "0.0.0.0"

def is_ip_allowed(ip: str) -> bool:
    return ip in IP_ALLOWLIST

async def auth_guard(request: Request, authorization: Optional[str] = Header(None)):
    client_ip = get_client_ip(request)
    if is_ip_allowed(client_ip):
        return
    token = None
    if authorization and authorization.lower().startswith("bearer "):
        token = authorization[7:].strip()
    if token and token in (ADMIN_BEARER_TOKEN, STATS_BEARER_TOKEN):
        return
    raise HTTPException(
        status_code=status.HTTP_401_UNAUTHORIZED,
        detail="Unauthorized",
        headers={"WWW-Authenticate": "Bearer"}
    )

@app.get("/debug/whoami", dependencies=[Depends(auth_guard)])
async def debug_whoami(request: Request):
    # 带 Bearer 或白名单访问，用于排查真实 IP 识别
    return {
        "client_ip": get_client_ip(request),
        "raw_client": request.client.host if request.client else None,
        "trusted_header": TRUST_PROXY_HEADER,
        "x_forwarded_for": request.headers.get("X-Forwarded-For", ""),
        "cf_connecting_ip": request.headers.get("CF-Connecting-IP", ""),
        "ip_allowlist": IP_ALLOWLIST,
    }

@app.post("/report")
async def receive_report(report: TrafficReport, token: str = Header(None)):
    if token != REPORT_TOKEN:
        raise HTTPException(status_code=403, detail="Invalid Token")
    
    if report.up_delta > 0 or report.down_delta > 0:
        conn = sqlite3.connect(DB_PATH)
        c = conn.cursor()
        c.execute("INSERT INTO records (node, user, up, down, timestamp) VALUES (?, ?, ?, ?, ?)",
                  (report.node, report.user, report.up_delta, report.down_delta, int(time.time())))
        conn.commit()
        conn.close()
    return {"status": "ok"}

def fetch_daily_stats(hours: int, detail: bool):
    hours = max(1, hours)
    start_time = int(time.time()) - (hours * 3600)
    conn = sqlite3.connect(DB_PATH)
    c = conn.cursor()

    if detail:
        c.execute('''SELECT user, node, SUM(up), SUM(down) FROM records WHERE timestamp > ?
                     GROUP BY user, node ORDER BY user, SUM(down) DESC''', (start_time,))
        rows = c.fetchall()
        result = [
            {
                "user": r[0],
                "node": r[1],
                "upload_mb": round(r[2] / 1024 / 1024, 2),
                "download_mb": round(r[3] / 1024 / 1024, 2),
                "total_mb": round((r[2] + r[3]) / 1024 / 1024, 2)
            }
            for r in rows
        ]
    else:
        c.execute('''SELECT user, SUM(up), SUM(down) FROM records WHERE timestamp > ?
                     GROUP BY user ORDER BY SUM(down) DESC''', (start_time,))
        rows = c.fetchall()
        result = [
            {
                "user": r[0],
                "node": "ALL",
                "upload_mb": round(r[1] / 1024 / 1024, 2),
                "download_mb": round(r[2] / 1024 / 1024, 2),
                "total_mb": round((r[1] + r[2]) / 1024 / 1024, 2)
            }
            for r in rows
        ]

    conn.close()
    return result

def log_subscription_hit(sub_id: str, request: Request):
    if not SUBS_PROXY_ENABLED:
        return
    try:
        client_ip = get_client_ip(request)
        forwarded_for = request.headers.get("X-Forwarded-For", "")
        user_agent = request.headers.get("User-Agent", "")
        query = request.url.query or ""
        conn = sqlite3.connect(DB_PATH)
        c = conn.cursor()
        c.execute(
            "INSERT INTO subscription_logs (sub_id, ip, forwarded_for, user_agent, query, timestamp) VALUES (?, ?, ?, ?, ?, ?)",
            (sub_id, client_ip, forwarded_for, user_agent, query, int(time.time()))
        )
        conn.commit()
        conn.close()
    except Exception:
        # logging suppressed to keep UI clean
        pass

