services:
{% for item in reality_instances %}
  reality_{{ item.name }}:
    container_name: "reality_{{ item.name }}"
    image: "{{ xray_image }}"
    restart: always
    user: "10000:10000"
    network_mode: "bridge"
    ports:
      - "0.0.0.0:{{ item.port }}:8443"
{% if ansible_default_ipv6 is defined and ansible_default_ipv6.address is defined %}
      - "[{{ ansible_default_ipv6.address }}]:{{ item.port }}:8443"
{% endif %}
    environment:
      - TZ=Asia/Shanghai
    volumes:
      - "{{ reality_data_dir }}/{{ item.name }}/config.json:/config.json:ro"
      - "{{ reality_logs_dir }}/{{ item.name }}:/var/log/xray"
    read_only: true
    tmpfs:
      - /tmp
      - /run
    cap_drop:
      - ALL
    security_opt:
      - no-new-privileges:true
    pids_limit: 256
    mem_limit: 512m
    ulimits:
      nofile:
        soft: 4096
        hard: 8192
      nproc: 512
{% endfor %}
