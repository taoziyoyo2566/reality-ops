{% set socks5_cfg = reality_socks5 | default({}) %}
{% set socks5_enabled = socks5_cfg.enabled | default(false) %}
{% set socks5_target_users = socks5_cfg.target_users | default([]) %}
{% set socks5_selected = item.name in socks5_target_users %}
{% set socks5_has_endpoint = (socks5_cfg.address | default('') | length > 0) and ((socks5_cfg.port | default(0) | int) > 0) %}
{% set use_socks5_egress = socks5_enabled and socks5_selected and socks5_has_endpoint %}
{
  "log": {
    "loglevel": "warning",
    "access": "/var/log/xray/access.log",
    "error": "/var/log/xray/error.log"
  },
  "api": {
    "tag": "api",
    "services": ["HandlerService", "LoggerService", "StatsService"]
  },
  "policy": {
    "levels": {
      "0": {
        "statsUserUplink": true,
        "statsUserDownlink": true,
        "handshake": 4,
        "connIdle": 300,
        "uplinkOnly": 0,
        "downlinkOnly": 0,
        "bufferSize": 0
      }
    },
    "system": {
      "statsInboundUplink": true,
      "statsInboundDownlink": true,
      "checkAccount": true,
      "strict": true
    }
  },
  "stats": {},
  "routing": {
    "domainStrategy": "IPIfNonMatch",
    "rules": [
      {
        "type": "field",
        "inboundTag": ["api"],
        "outboundTag": "direct"
      },
      {
        "type": "field",
        "protocol": ["bittorrent"],
        "outboundTag": "blocked"
      }
    ]
  },
  "inbounds": [
    {
      "port": 8443,
      "protocol": "vless",
      "settings": {
        "clients": [
          {
            "id": "{{ item.uuid }}",
            "email": "{{ item.name }}.{{ inventory_hostname }}@{{ domain_suffix }}",
            "flow": "xtls-rprx-vision",
            "level": 0,
            "alterId": 0,
            "expire": "{{ item.expire | default('') }}"
          }
        ],
        "decryption": "none"
      },
      "streamSettings": {
        "network": "tcp",
        "security": "reality",
        "realitySettings": {
          "show": false,
          "dest": "{{ reality_dest }}",
          "xver": 0,
          "serverNames": {{ reality_server_names | to_json }},
          "privateKey": "{{ item.private_key }}",
          "shortIds": ["{{ item.short_id }}"]
        }
      }
    },
    {
      "port": 10085,
      "listen": "127.0.0.1",
      "protocol": "dokodemo-door",
      "settings": {
        "address": "127.0.0.1"
      },
      "tag": "api"
    }
  ],
  "outbounds": [
    {% if use_socks5_egress %}
    {
      "protocol": "socks",
      "settings": {
        "servers": [
          {
            "address": "{{ socks5_cfg.address }}",
            "port": {{ socks5_cfg.port | int }}
            {% if (socks5_cfg.username | default('') | length > 0) or (socks5_cfg.password | default('') | length > 0) %}
            ,
            "users": [
              {
                "user": "{{ socks5_cfg.username | default('') }}",
                "pass": "{{ socks5_cfg.password | default('') }}"
              }
            ]
            {% endif %}
          }
        ]
      },
      "tag": "socks5-egress"
    },
    {% endif %}
    {
      "protocol": "freedom",
      "settings": {},
      "tag": "direct"
    },
    {
      "protocol": "blackhole",
      "settings": {},
      "tag": "blocked"
    }
  ]
}
