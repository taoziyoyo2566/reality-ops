# {{ ansible_managed | default('managed by reality-ops') }}
# xray_edge 访问与错误日志轮转，由 compose 服务 logrotate 每 {{ edge_logrotate_interval }} 秒调用一次，
# 状态文件在 {{ edge_root_dir }}/rotate/state，不经宿主机 logrotate 或 systemd。
# 路径是 logrotate 容器内的挂载点（{{ edge_root_dir }}/logs -> /var/log/xray）。
# copytruncate：Xray 以只读根文件系统和 cap_drop ALL 运行，改名后仍会写旧 fd；
# 拷贝与截断之间有极小丢行窗口，对 IP 审计可以接受。
/var/log/xray/*.log {
    daily
    rotate {{ edge_log_rotate_keep }}
    maxsize {{ edge_log_rotate_maxsize }}
    compress
    copytruncate
    notifempty
    missingok
    nocreate
}
