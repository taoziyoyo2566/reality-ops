# 模板文件，勿直接用于生产；真实机密请放到 .env（已在 .gitignore）或 Ansible Vault
# GitHub Personal Access Token（需要 gist 权限）
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Gist ID (订阅文件 Gist)
GIST_ID=0a7faae910b06151d643c7d5baa43818

# Admin API 管理接口
# 强随机串，供 n8n/Bot 在 Authorization: Bearer <token> 中携带
ADMIN_TOKEN=CHANGEME-admin-token
# 订阅/Feed 的外网域名（用于拼接 /feed/<token> 链接），不要留空
SUBS_BASE_URL=https://your-domain.example.com
